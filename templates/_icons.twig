{# Small line icons, drawn inline so nothing is loaded from elsewhere. #}
{% macro icon(name, class = 'icon') %}
<svg class="{{ class }}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {% if name == 'logo' %}
        <path d="M12 3 4 7.5v9L12 21l8-4.5v-9L12 3Z"/><circle cx="12" cy="12" r="1.8"/>
    {% elseif name == 'search' %}
        <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    {% elseif name == 'check' %}
        <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {% elseif name == 'arrow' %}
        <path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
    {% elseif name == 'image' %}
        <rect x="3" y="4" width="18" height="16" rx="2.5"/><circle cx="9" cy="10" r="1.6"/><path d="m4 18 5.5-5 4 3.5 2.5-2.2L20 18"/>
    {% elseif name == 'mail' %}
        <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>
    {% elseif name == 'bell' %}
        <path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
    {% elseif name == 'bag' %}
        <path d="M16 11V7a4 4 0 0 0-8 0v4M5 9h14l1 12H4L5 9Z"/>
    {% endif %}
</svg>
{% endmacro %}
