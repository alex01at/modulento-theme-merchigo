{# Receives block: texts (heading), links (title, url). #}
{% if block.links %}
<section class="band">
    <div class="container narrow">
        {% if block.texts.heading or edit_mode() %}<h2 data-field="heading">{{ block.texts.heading }}</h2>{% endif %}
        <ul class="plain-list">
            {% for link in block.links %}
                <li><a href="{{ link.url starts with '/' ? url(link.url) : link.url }}">{{ link.title }}</a></li>
            {% endfor %}
        </ul>
    </div>
</section>
{% endif %}
