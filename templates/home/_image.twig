{# Receives block: media, texts (caption). #}
{% if block.media %}
<section class="band">
    <div class="container narrow">
        <figure>
            <img src="{{ block.media }}" alt="{{ block.texts.caption }}" loading="lazy">
            {% if block.texts.caption or edit_mode() %}<figcaption data-field="caption">{{ block.texts.caption }}</figcaption>{% endif %}
        </figure>
    </div>
</section>
{% endif %}
